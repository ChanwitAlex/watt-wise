# คัดลอกเป็น .env.local แล้วแก้ค่า (ห้าม commit ไฟล์ .env.local)

# สตริงสุ่มยาวอย่างน้อย 32 ตัวอักษร ใช้เซ็นคุกกี้ session  สร้างด้วย:  openssl rand -base64 32
SESSION_SECRET=

# ฐานข้อมูล Postgres (Neon) จำเป็นบน Vercel ถ้าอยากให้สมัครสมาชิกได้
# ถ้าเว้นว่างตอนรันในเครื่อง ระบบจะเก็บบัญชีไว้ในไฟล์ data/.users.json (ใช้บน Vercel ไม่ได้)
DATABASE_URL=

# เปิด/ปิดปุ่มทดลองใช้โดยไม่ต้องสมัคร (ค่าเริ่มต้น เปิด) ตั้งเป็น false เพื่อปิด
DEMO_ENABLED=true

# (ไม่บังคับ) เปลี่ยนที่อยู่ API พยากรณ์อากาศ เช่น ใช้ทดสอบกับเซิร์ฟเวอร์จำลอง ค่าเริ่มต้นคือ https://api.open-meteo.com/v1/forecast
# WEATHER_API_URL=
# WEATHER_API_URL / ARCHIVE_API_URL ใช้ชี้ไปเซิร์ฟเวอร์จำลองตอนทดสอบ (ไม่บังคับ)
# ARCHIVE_API_URL=
